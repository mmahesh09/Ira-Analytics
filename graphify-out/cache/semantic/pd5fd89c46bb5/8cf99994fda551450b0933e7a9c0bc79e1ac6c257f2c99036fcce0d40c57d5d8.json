{"nodes": [{"id": "deploy_rankwise_deployment_guide", "label": "Rankwise Deployment Guide", "file_type": "document", "rationale": "Three free options sharing one Docker image (backend/Dockerfile) so moving hosts later is painless; secrets only go into host settings screens, never chat or git.", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_hugging_face_spaces", "label": "Hugging Face Spaces (Docker Space)", "file_type": "concept", "rationale": "Recommended: free, no credit card, 2 vCPU/16 GB so every module (local Lighthouse, Accessibility, Visual Doctor) works; sleeps after ~48h idle.", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_neon_postgres", "label": "Neon Postgres", "file_type": "concept", "rationale": "Free, no card, no expiry, SSL included; chosen over Render's free Postgres which expires after 30 days.", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_render_free_tier", "label": "Render Free Tier", "file_type": "concept", "rationale": "No card but only 512 MB RAM, so Chromium/Lighthouse are excluded; Speed falls back to PageSpeed Insights and Accessibility/Visual Doctor show unavailable.", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_oracle_cloud_free_vm", "label": "Oracle Cloud Always Free VM (A1.Flex 4 OCPU/24 GB)", "file_type": "concept", "rationale": "Fully open source and powerful, but Oracle asks for a card; same compose file moves unchanged to paid hosts later.", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_coolify", "label": "Coolify (self-hosted PaaS)