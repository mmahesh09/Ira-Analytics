# Placeholders only: real values go in .env.local (ignored) or the host's settings (Vercel / Cloudflare).

# Public URL of the FastAPI backend (no secrets here: this is shipped to the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
# where /api/* (except /api/auth) is proxied; server-side only
BACKEND_URL=http://localhost:8000

# --- Server-only. Never prefix these with NEXT_PUBLIC_ ---
# Neon pooled connection string (same database as the backend)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# random, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# the site's public URL (https in production: cookies are then Secure)
BETTER_AUTH_URL=http://localhost:3000
# header with the real client IP for sign-in rate limits. Detected automatically on Vercel (x-real-ip) and
# Cloudflare Workers (cf-connecting-ip); set it only behind another proxy
AUTH_IP_HEADER=

# Password reset + email verification: off until a provider is set. resend = Resend API; console = print to the
# server log (development only)
EMAIL_PROVIDER=
EMAIL_FROM=Rankwise <no-reply@example.com>
RESEND_API_KEY=
# true once existing accounts have verified their email: no sign-in before verification, and sign-up no longer
# reveals whether an address already has an account
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# true = send the Content-Security-Policy as report-only (a quick way back if a new integration is blocked)
CSP_REPORT_ONLY=false
