# development | production. Production refuses to start on unsafe settings (missing PREVIEW_SALT, http:// URLs, ...),
# hides /docs and sends HSTS
APP_ENV=development

# Comma-separated list of allowed frontend origins (CORS for the audit stream, and the Origins trusted for signed-in writes)
CORS_ORIGINS=http://localhost:3000

# Optional: Google PageSpeed Insights key (works without one, but with a low shared quota)
PAGESPEED_API_KEY=

# Optional: OpenRouter key enables live AI-visibility probes in the GEO module
OPENROUTER_API_KEY=
# Models used for GEO probes (OpenRouter model IDs, comma-separated)
GEO_MODELS=perplexity/sonar,openai/gpt-4o-mini

# Optional: DataForSEO credentials enable estimated traffic + ranking keywords
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Anonymous preview audits (light checks, not saved): per visitor IP per UTC day, and across everyone per day
PREVIEW_PER_IP_PER_DAY=2
PREVIEW_DAILY_CAP=200
# random string used to hash visitor IPs (never stored in plain text)
PREVIEW_SALT=

# Product feedback (/feedback form, /app/admin/feedback dashboard)
# comma-separated emails that may read and export feedback; the account must also have a verified email
ADMIN_EMAILS=
# public form submissions per visitor IP per 10 minutes
FEEDBACK_PER_IP_PER_10MIN=5

# per signed-in user per minute: all requests / state-changing requests; request bodies over MAX_BODY_BYTES get 413
USER_RATE_PER_MIN=300
USER_WRITE_RATE_PER_MIN=60
MAX_BODY_BYTES=262144
# proxies in front of the API that append to X-Forwarded-For: 0 locally, 1 on Render. Higher values let clients spoof IPs
TRUSTED_PROXY_HOPS=0

# --- Platform (sites, tracking). Accounts are Better Auth in frontend/ ---
# Local PostgreSQL 18 example; the 'rankwise' database is created on first setup
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/rankwise
# Public URL of this API, used in the tracking snippet
PUBLIC_API_URL=http://localhost:8000

# Tests only: a disposable, migrated local database for the credit-ledger tests (they skip without it; non-local hosts are refused)
# docker run -d --name rankwise-testdb -e POSTGRES_USER=rw_test -e POSTGRES_PASSWORD=rw_test_local -e POSTGRES_DB=rankwise_test -p 127.0.0.1:55432:5432 postgres:18
TEST_DATABASE_URL=

# --- Visual Doctor screenshots: Neon Object Storage (S3-compatible). Leave the AWS_* values empty to keep them on local disk ---
SHOTS_BUCKET=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Razorpay subscriptions (use rzp_test_ keys in development) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > secret; endpoint: <PUBLIC_API_URL>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# printed by: .venv\Scripts\python -m scripts.create_razorpay_plans
RAZORPAY_PLANS=
# true once International Payments is approved and USD plans exist
RAZORPAY_USD_ENABLED=false

# Speed fallback: run Lighthouse locally (needs the 'lighthouse' CLI + Chrome/Edge) when PageSpeed Insights is unavailable
LOCAL_LIGHTHOUSE=true
# optional: path to chrome.exe / msedge.exe (auto-detected on Windows and Linux)
LIGHTHOUSE_CHROME_PATH=
